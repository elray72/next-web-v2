{
  "name": "next-web",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "shared",
    "site"
  ],
  "scripts": {
    "dev": "pnpm --filter @web/site dev",
    "mcd": "pnpm --filter @web/site mcd",
    "twd": "pnpm --filter @web/site twd",
    "dw": "pnpm --filter @web/site dw",
    "build": "pnpm --filter @web/site build",
    "cms:build": "dotnet build cms/DW.Cms.csproj",
    "cms:run": "dotnet run --project cms/DW.Cms.csproj"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
