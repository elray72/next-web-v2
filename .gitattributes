# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# Explicitly declare text files
*.cs text diff=csharp
*.csproj text diff=csharp
*.sln text
*.config text
*.json text
*.js text
*.jsx text
*.ts text
*.tsx text
*.md text
*.yml text
*.yaml text
*.sh text eol=lf
*.bash text eol=lf

# Declare files that will always have LF line endings on checkout
*.sql text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
